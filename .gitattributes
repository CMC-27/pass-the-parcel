# Normalize all text files to LF for byte-for-byte stability.
# Prevents CRLF/LF drift from silently breaking PREFIX-LOCKED KV-cache matching
# in .devops/agents/*.md (which must stay byte-identical to .opencode/plans/base-context.md).
* text=auto eol=lf

# Explicitly pin the canonical header + agent files (PREFIX-LOCKED contract).
.opencode/plans/base-context.md text eol=lf
.devops/agents/*.md text eol=lf
.devops/skills/ptp-*/SKILL.md text eol=lf
.devops/skills/pass-the-parcel/** text eol=lf
.devops/skills/agent-wrap-up/SKILL.md text eol=lf
.wiki/rules/** text eol=lf
.devops/rules/** text eol=lf
scripts/wiki_lint.py text eol=lf

# Remaining portable text surface (byte-stability contract, not just the catch-all).
AGENTS.md text eol=lf
HOW-TO.md text eol=lf
README.md text eol=lf
opencode.json text eol=lf
scripts/*.ps1 text eol=lf
scripts/*.py text eol=lf
scripts/*.cjs text eol=lf
.devops/templates/** text eol=lf
.devops/sync-manifest.yaml text eol=lf
.vscode/*.json text eol=lf
.github/workflows/*.yml text eol=lf

# Binary files must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary